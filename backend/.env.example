# AI Productivity Suite — Backend Environment Variables
# Copy this file to '.env' and add your actual API keys.

# ==========================================
# 1. LLM Provider — Choose ONE (or both)
# ==========================================
# OPTION A: OpenRouter (FREE models available — RECOMMENDED)
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_MODEL=google/gemini-2.0-flash-exp:free

# OPTION B: Google Gemini (Fallback if OpenRouter is not set)
GEMINI_API_KEY=your_gemini_api_key_here

# ==========================================
# 2. Server Configuration
# ==========================================
PORT=8000
DATABASE_PATH=./data/chat_history.db

# ==========================================
# 3. OpenRouter Branding Headers (Optional)
# ==========================================
SITE_URL=http://localhost:3000
SITE_NAME=AI Productivity Suite
